<mvc:View 
xmlns:mvc="sap.ui.core.mvc" 
xmlns="sap.m" 
xmlns:l="sap.ui.layout" 
xmlns:f="sap.ui.layout.form" 
xmlns:core="sap.ui.core" 
xmlns:html="http://www.w3.org/1999/xhtml" 
controllerName="serviacero.custom.plugins.zpluginReimpresionStu.zpluginReimpresionStu.controller.MainView" 
width="100%" 
height="100%">
		
        <Panel 
                id="panelPlugin"  
                width="100%"
                height="100%"
                expandable="false"
                expanded="false"
                accessibleRole="Region"
                backgroundDesign="Transparent"
                class="sapUiNoContentPadding">  
        <headerToolbar>
            <Toolbar height="3rem">
                <Button
                    id="backButton"
                    visible="false"
                    text="{i18n>template.back.btn}"
                    tooltip="{i18n>template.back.tooltip}"
                    icon="sap-icon://nav-back"
                    press="onBackPress"/>
                <Title id="headerTitle" text=""/>
                <ToolbarSpacer/>
                <Button
                    id="closeButton"
                    visible="false"
                    tooltip="{i18n>template.close.tooltip}"
                    icon="sap-icon://decline"
                    press="onClosePress"/>
            </Toolbar>
        </headerToolbar>
        <content> 
            <l:VerticalLayout width="100%">
                <HBox width="auto" alignItems="Center" wrap="Wrap" class="sapUiSmallMarginTop sapUiSmallMarginBeginEnd">
                    <Label text="{i18n>plant}" class="sapUiTinyMarginEnd" />
                    <Input id="filterPlant" width="90px" value="{tableModel>/filterPlant}" class="sapUiSmallMarginEnd" enabled="false" />
                    <Label text="{i18n>workCenter}" class="sapUiTinyMarginEnd" />
                    <Input id="filterWorkCenter" width="90px" value="{tableModel>/filterWorkCenter}" class="sapUiSmallMarginEnd" enabled="false" />
                    <Label text="{i18n>order}" class="sapUiTinyMarginEnd" />
                    <Input id="filterOrder" width="100px" value="{tableModel>/filterOrder}" submit="onSearchOrder" class="sapUiSmallMarginEnd" />
                    <Button text="{i18n>search}" icon="sap-icon://search" press="onSearchOrder" />
                </HBox>

                <Table busyIndicatorDelay="5" id="labelTable" items="{tableModel>/ITEMS}"
                class="sapUiSmallMarginTop" width="100%" alternateRowColors="true" noDataText="{i18n>noData}" visibleRowCountMode="Auto">
                <headerToolbar>
                    <Toolbar>
                        <Title text="{i18n>Items} ({= ${tableModel>/ITEMS}.length})" />
                    </Toolbar>
                </headerToolbar>
                <columns>
                    <Column width="18%" hAlign="Left" vAlign="Middle">
                        <Text text="{i18n>lotes}" />
                    </Column>
                    <Column width="10%" hAlign="Left" vAlign="Middle">
                        <Text text="{i18n>orden}" />
                    </Column>
                    <Column width="12%" hAlign="Left" vAlign="Middle">
                        <Text text="{i18n>cantidadPosteada}" />
                    </Column>
                    <Column width="18%" hAlign="Left" vAlign="Middle">
                        <Text text="{i18n>fechaPosteo}" />
                    </Column>
                    <Column width="16%" hAlign="Left" vAlign="Middle">
                        <Text text="{i18n>usuario}" />
                    </Column>
                    <Column width="10%" hAlign="Center" vAlign="Middle">
                        <Text text="{i18n>impresion}" />
                    </Column>
                </columns>
                <items>
                    <ColumnListItem vAlign="Middle">
                        <cells>
                            <ObjectIdentifier title="{tableModel>batchNumber}" text="{tableModel>material}" />
                            <Text text="{tableModel>order}" />
                            <ObjectAttribute text="{tableModel>quantityValue} {tableModel>uom}" />
                            <Text text="{tableModel>postingDateTime}" />
                            <Text text="{tableModel>postedBy}" />
                            <Button icon="sap-icon://print" press=".onPrint"/>
                        </cells>
                    </ColumnListItem>
                </items>
            </Table>
            </l:VerticalLayout>
        </content>
	    </Panel>		
        
  
</mvc:View>